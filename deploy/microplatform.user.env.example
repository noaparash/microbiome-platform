# Microbiome Platform — settings for a *user-level* install on a shared server (no sudo).
# Copy to ~/.config/microplatform/microplatform.env and make it private:
#   mkdir -p ~/.config/microplatform && chmod 700 ~/.config/microplatform
#   install -m 600 deploy/microplatform.user.env.example ~/.config/microplatform/microplatform.env
# Not in Git. Both user services read it. After a change:
#   systemctl --user restart microplatform-web microplatform-worker

# A long random secret that signs session cookies. Generate one straight into this file, e.g.:
#   sed -i "s/^MICROPLATFORM_SECRET_KEY=.*/MICROPLATFORM_SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_hex(32))')/" ~/.config/microplatform/microplatform.env
MICROPLATFORM_SECRET_KEY=

# Uploads, results and the cache (create it with mode 700: only you can read it).
MICROPLATFORM_INSTANCE=/home/<you>/microplatform-instance
MICROPLATFORM_JOBS=external

# Listen on a socket file inside a private folder (mode 700), not on a TCP port: on a shared
# server 127.0.0.1 is shared by every user of the machine. Reach it with an SSH tunnel:
#   ssh -N -L 8000:/home/<you>/microplatform-run/web.sock <server>   then open http://127.0.0.1:8000
MICROPLATFORM_BIND=unix:/home/<you>/microplatform-run/web.sock
MICROPLATFORM_WEB_WORKERS=2

# No HTTPS front end yet (internal use through the tunnel): leave these at 0.
MICROPLATFORM_TRUST_PROXY=0
MICROPLATFORM_COOKIE_SECURE=0
# Empty: results links use the address you opened (http://127.0.0.1:8000 through the tunnel).
MICROPLATFORM_PUBLIC_URL=

# Tasks this server does not offer, comma-separated (preprocess, differ, predict, group, metabolites).
# They are listed as "Not on this server" and cannot run. Empty: everything is offered.
MICROPLATFORM_DISABLED_GOALS=

# Email (optional; OFF while HOST or SENDER is empty). See deploy/microplatform.env.example.
MICROPLATFORM_SMTP_HOST=
MICROPLATFORM_SMTP_SENDER=
# The name shown as the sender (optional; default: Microbiome Platform)
#MICROPLATFORM_SMTP_SENDER_NAME=Microbiome Platform
MICROPLATFORM_SMTP_SECURITY=starttls
MICROPLATFORM_SMTP_PORT=
MICROPLATFORM_SMTP_USER=
MICROPLATFORM_SMTP_PASSWORD=

# No screen on a server.
QT_QPA_PLATFORM=offscreen
MPLBACKEND=Agg
