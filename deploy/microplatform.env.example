# Microbiome Platform — server settings (template).
#
# Copy to /etc/microplatform/microplatform.env and fill in. That file is NOT in Git
# and must be readable only by root and the service account:
#   sudo install -m 640 -o root -g microplatform deploy/microplatform.env.example /etc/microplatform/microplatform.env
# Both services (website and worker) read it. After a change: sudo systemctl restart microplatform-web microplatform-worker

# --- Required ----------------------------------------------------------------------

# A long random secret that signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit it, never reuse it elsewhere.
MICROPLATFORM_SECRET_KEY=

# Where uploads, results and the cache live (private to the service account).
MICROPLATFORM_INSTANCE=/var/lib/microplatform

# Queue only: the website queues, the separate worker service runs the analyses.
MICROPLATFORM_JOBS=external

# --- Web address and network ---------------------------------------------------------

# The address users open — used for the results links (and in emails).
MICROPLATFORM_PUBLIC_URL=https://microbiome.example.ac.il

# Where gunicorn listens: on this machine only; nginx serves HTTPS in front of it.
MICROPLATFORM_BIND=127.0.0.1:8000
MICROPLATFORM_WEB_WORKERS=2

# Behind nginx with HTTPS: trust its forwarded headers, and send cookies over HTTPS only.
MICROPLATFORM_TRUST_PROXY=1
MICROPLATFORM_COOKIE_SECURE=1

# Largest upload accepted, in MB (keep nginx's client_max_body_size the same).
MICROPLATFORM_MAX_UPLOAD_MB=100

# --- Email when an analysis finishes (optional; OFF while these are empty) -------------
# Fill in when the lab provides the mail server. Emails contain only the results link.
MICROPLATFORM_SMTP_HOST=
MICROPLATFORM_SMTP_SENDER=
MICROPLATFORM_SMTP_PORT=587
MICROPLATFORM_SMTP_USER=
MICROPLATFORM_SMTP_PASSWORD=
MICROPLATFORM_SMTP_TLS=1

# --- LOCATE (optional; not enabled yet) -------------------------------------------------
# LOCATE runs in its own Python 3.10 environment (its pinned libraries do not install on
# Python 3.13). The interpreter of that environment, e.g. /opt/locate-env/bin/python.
# Empty: LOCATE is unavailable and every other tool works as usual.
MICROPLATFORM_LOCATE_PYTHON=

# --- Housekeeping for the scientific libraries (no screen on a server) ------------------
QT_QPA_PLATFORM=offscreen
MPLBACKEND=Agg
HOME=/var/lib/microplatform
MPLCONFIGDIR=/var/lib/microplatform/.config/matplotlib
NUMBA_CACHE_DIR=/var/lib/microplatform/.cache/numba
