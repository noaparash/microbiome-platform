# Microbiome Platform — the worker: runs the queued analyses, one at a time.
# Install: sudo cp deploy/systemd/microplatform-worker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now microplatform-worker

[Unit]
Description=Microbiome Platform analysis worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=microplatform
Group=microplatform
WorkingDirectory=/var/lib/microplatform
EnvironmentFile=/etc/microplatform/microplatform.env
ExecStart=/opt/microplatform/.venv/bin/python -m microplatform.worker --instance /var/lib/microplatform
Restart=always
RestartSec=10

# Graceful stop: on "systemctl stop/restart" the worker finishes the analysis in progress
# before exiting. Allow up to 30 minutes for that (iMic takes seconds, GIMIC minutes).
KillSignal=SIGTERM
TimeoutStopSec=1800

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/microplatform

[Install]
WantedBy=multi-user.target
