# Microbiome Platform — the worker: runs the queued analyses, one at a time.
# Install: sudo cp deploy/systemd/microplatform-worker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now microplatform-worker

[Unit]
Description=Microbiome Platform analysis worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=microplatform
Group=microplatform
WorkingDirectory=/var/lib/microplatform
EnvironmentFile=/etc/microplatform/microplatform.env
ExecStart=/opt/microplatform/.venv/bin/python -m microplatform.worker --instance /var/lib/microplatform
Restart=always
RestartSec=10

# Graceful stop: on "systemctl stop/restart" (and on a reboot) the worker finishes the analysis
# in progress before exiting. Allow up to 4 hours, so a long run (e.g. miMic on a large dataset:
# over 60 minutes) finishes instead of being interrupted. To be tuned from the run-time table.
# The worker exits as soon as the run ends, so an idle worker stops at once. To stop it now
# anyway (the run is then marked interrupted): sudo systemctl kill microplatform-worker
KillSignal=SIGTERM
TimeoutStopSec=4h

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/microplatform

[Install]
WantedBy=multi-user.target
