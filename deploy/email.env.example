# Email settings for a laptop or a single computer (the server uses /etc/microplatform/microplatform.env).
# Copy to <instance>/email.env (by default: instance/email.env next to where the website runs).
# That folder is not in Git. Type the real password only into the copy, never into this template.
# Check with one test email:  uv run python -m microplatform.notify --to you@example.ac.il
MICROPLATFORM_SMTP_HOST=
MICROPLATFORM_SMTP_SENDER=
# The name shown as the sender (optional; default: Microbiome Platform)
#MICROPLATFORM_SMTP_SENDER_NAME=Microbiome Platform
# starttls (port 587, the usual), ssl (port 465) or none (port 25)
MICROPLATFORM_SMTP_SECURITY=starttls
MICROPLATFORM_SMTP_PORT=
MICROPLATFORM_SMTP_USER=
MICROPLATFORM_SMTP_PASSWORD=
